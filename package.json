{
  "name": "subversive-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "gen": "node scripts/gen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-style.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "build": "next build",
    "start": "next start",
    "e2e": "playwright test --project=iphone-15 --project=iphone-se --project=ipad --project=desktop-chromium",
    "e2e:all": "playwright test",
    "e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "lhci": "lhci autorun",
    "contrast": "node scripts/check-contrast.ts",
    "budget": "node scripts/check-js-budget.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "us-atlas": "^3.0.1",
    "vitest": "^5.1.0"
  }
}
